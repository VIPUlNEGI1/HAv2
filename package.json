{
  "name": "Hosiptalapp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "pod": "cd ios && RCT_NEW_ARCH_ENABLED=1 pod install",
    "clean": "echo '🧹 Cleaning Mobile Workspace...'; rm -rf yarn.lock node_modules node_modules ios/build ios/Pods ios/Podfile.lock android/.gradle android/build android/app/build android/a packages/web/node_modules && echo '✅ Mobile workspace cleaned!';",
    "prettier": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "linter": "eslint --fix 'src/**/*.{js,jsx,ts,tsx}'",
    "reset": "watchman watch-del-all && APP_ENV=dev npx  react-native start --reset-cache",
    "prepare": "husky",
    "generate": "plop && prettier --write 'src/**/*.{js,jsx,ts,tsx}' && eslint --fix 'src/**/index.ts'"
  },
  "dependencies": {
    "@backpackapp-io/react-native-toast": "^0.15.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@react-navigation/stack": "^7.6.16",
    "@supabase/supabase-js": "^2.93.2",
    "lucide-react-native": "^0.563.0",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-config": "^1.6.1",
    "react-native-device-info": "^15.0.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-gifted-chat": "^3.3.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "^1.20.7",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.26.20",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.20.0",
    "react-native-svg": "^15.15.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.7.2",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
